# Pulse — переменные окружения для фронта (Vite, префикс VITE_).
# Скопируй этот файл в `.env` и подставь свои значения. Перезапусти dev/build.

# === LLM (обязательно для работы чата) ===
# По умолчанию: локальный LM Studio с моделью gemma2:2b.
# LM Studio отдаёт OpenAI-совместимый /v1/chat/completions (SSE), ключ не
# проверяется — можно любую строку (по дефолту 'lm-studio').
# Поднять сервер:  lms server start  (CLI из C:\Users\1\.lmstudio\bin\lms.exe)
# Скачать модель:  lms get gemma2:2b
# Endpoint по дефолту:  http://127.0.0.1:1234/v1

VITE_LLM_BASE_URL=http://127.0.0.1:11434/v1
VITE_LLM_API_KEY=ollama
VITE_LLM_MODEL=gemma2:2b

# === Vision (multimodal) — Pulse v5.1 ===
# Если в сообщении есть картинка (скриншот или 📎-картинка) — клиент
# автоматически переключается на эту модель. Скачать: ollama pull gemma3:4b
# Если не задана — картинки не отправляются в LLM (только текстовое описание в UI).
VITE_LLM_VISION_MODEL=gemma3:4b

# Чтобы переключить на OpenAI-совместимое облако — поменяй URL и модель ниже,
# и обязательно укажи реальный ключ.

# OpenAI: https://platform.openai.com/api-keys
# VITE_LLM_BASE_URL=https://api.openai.com/v1
# VITE_LLM_API_KEY=sk-...
# VITE_LLM_MODEL=gpt-4o-mini

# OpenRouter (один ключ → все модели): https://openrouter.ai/keys
# VITE_LLM_BASE_URL=https://openrouter.ai/api/v1
# VITE_LLM_API_KEY=sk-or-...
# VITE_LLM_MODEL=anthropic/claude-3.5-haiku

# Старый вариант (Ollama, больше не поддерживаем основным):
# VITE_LLM_BASE_URL=http://127.0.0.1:11434/v1
# VITE_LLM_API_KEY=ollama
# VITE_LLM_MODEL=gemma2:2b

# === Habr search (бэкенд, читается на Rust-стороне) ===
# URL локального habr-search. По умолчанию http://127.0.0.1:3000.
# Раскомментируй и поменяй, если поднят на другом хосте/порту.
# HABR_SEARCH_URL=http://127.0.0.1:3000
